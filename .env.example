# Frontend Configuration
# THE URL where your backend API is accessible.
# In development, it usually points to your local backend server's port.
# Note: Vite requires the 'VITE_' prefix for variables to be accessible in the client code.
VITE_API_BASE_URL=http://localhost:5001

# SEO and Open Graph
# The absolute URL of the default Open Graph image (og:image) used for SEO previews
VITE_OG_IMAGE=https://wine.fahmiefendy.dev/og-image.png

